    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@lanboot/ipxe": "workspace:*",
    "@lanboot/lio": "workspace:*",
    "@lanboot/storage": "workspace:*",
    "@lanboot/validators": "workspace:*",
    "express": "^5.2.1",
    "zx": "catalog:"
  },
  "files": [
    "build",
    "public"
  ]
