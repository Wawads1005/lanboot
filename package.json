{
  "name": "lanboot",
  "version": "1.0.0",
  "scripts": {
    "dev": "dotenv -e .env.local -- turbo dev",
    "build": "turbo build",
    "clean": "find . -type d \\( -name node_modules -o -name build -o -name .turbo \\) -prune -exec rm -rf {} +"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "devDependencies": {
    "concurrently": "catalog:",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.11.7"
  },
  "license": "AGPL-3.0-or-later"
}
